[Unit]
Description=Rathole Server Service
After=network.target

[Service]
Type=simple
Restart=on-failure
RestartSec=5s
LimitNOFILE=1048576

# with root
ExecStart=/usr/bin/rathole server /etc/rathole/%i.toml
# without root
# ExecStart=%h/.local/bin/rathole server %h/.local/etc/rathole/%i.toml

[Install]
WantedBy=multi-user.target
